# Backend .gitignore - Node + TypeScript

# dependencies
/node_modules/

# build output
/dist/
/build/

# dotenv environment variables
.env
.env.*.local
.env.local

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# testing
/coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# misc
.DS_Store
.vscode/
.idea/
# runtime files
pids/
*.pid

# local dev files
.vite/

